# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Backend secrets
backend/.env
backend/firebase-service-account.json

# Secrets, generally
*.env
*firebase*key*.json
*serviceAccount*.json

# ML artifacts
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep
ml/models/*.joblib
ml/.ipynb_checkpoints/

# Raw geospatial/reference datasets (2GB+, several files over GitHub's
# 100MB hard limit) — not meant to be versioned, same rationale as
# ml/data/raw/ above.
/datas/

# Node / Firebase Functions
functions/node_modules/
functions/lib/
firebase-debug.log
firebase-debug.*.log
.firebase/

# Flutter (app/ has its own .gitignore too, this covers the root view)
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/android/local.properties
app/ios/Flutter/Generated.xcconfig
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist
app/*.iml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
