rules_version = '2';

// TODO: tighten before production. This encodes the three-role model:
// citizens can read district risk data and manage their own reports;
// field officials can additionally update road status; analysts/admins
// have full read/write for moderation and alert overrides.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAnalyst() {
      return isSignedIn() && role() == 'analyst_admin';
    }

    function isFieldOfficial() {
      return isSignedIn() && role() == 'field_official';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAnalyst());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAnalyst();
    }

    match /districts_risk/{districtId} {
      allow read: if isSignedIn();
      allow write: if isAnalyst(); // risk scores are written by the ML pipeline / Cloud Function
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAnalyst() || (isSignedIn() && resource.data.reporter_uid == request.auth.uid);
      allow delete: if isAnalyst();
    }

    match /roads/{roadId} {
      allow read: if isSignedIn();
      allow write: if isFieldOfficial() || isAnalyst();
    }

    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isAnalyst();
    }
  }
}
